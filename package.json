{
  "name": "angels-delight-tv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:file": "vitest run",
    "test:related": "vitest related --run",
    "footprint": "scripts/footprint-check.sh",
    "hooks:install": "scripts/install-hooks.sh",
    "db:seed:admin": "pnpm --filter @ad/auth run seed:admin",
    "db:seed:demo": "pnpm --filter @ad/catalog run seed:demo",
    "brand:generate": "tsx scripts/generate-brand-kit.ts",
    "launch:apply": "tsx packages/launch/src/cli/apply.ts",
    "secrets:generate": "tsx packages/launch/src/cli/secrets.ts",
    "content:import": "tsx packages/launch/src/cli/import.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
