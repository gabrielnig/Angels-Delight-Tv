{
  "name": "@ad/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:file": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed:admin": "pnpm --filter @ad/auth run seed:admin",
    "db:seed:demo": "pnpm --filter @ad/catalog run seed:demo"
  },
  "dependencies": {
    "@ad/config": "workspace:*",
    "@ad/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
