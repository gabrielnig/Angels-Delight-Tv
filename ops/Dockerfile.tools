# syntax=docker/dockerfile:1
# Operator tools image: launch:apply, content:import, secrets, backup and restore, seed-admin.
# Build from the repository root: docker build -f ops/Dockerfile.tools .
FROM node:24-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /repo
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --filter @ad/launch...
# Workspace packages ship TypeScript source, so the tools run through tsx like the worker.
RUN pnpm --filter @ad/launch deploy --legacy --prod /out

FROM node:24-bookworm-slim AS runtime
# pg_dump and pg_restore must be at least the server major version (postgres 17), so they come from the PGDG repo.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
  && install -d /usr/share/postgresql-common/pgdg \
  && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
  && . /etc/os-release \
  && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends postgresql-client-17 \
  && apt-get purge -y --auto-remove curl gnupg \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
RUN mkdir -p /backups /data/brand && chown node:node /backups /data/brand
WORKDIR /app
COPY --from=build --chown=node:node /out ./
COPY --chown=root:root ops/ad-tool /usr/local/bin/ad-tool
RUN chmod 0755 /usr/local/bin/ad-tool
USER node
ENTRYPOINT ["ad-tool"]
CMD ["help"]
