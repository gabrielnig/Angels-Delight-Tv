# Names only. Copy to .env and fill dev values. Never commit .env.
# Generate each 32 byte key with: openssl rand -base64 32

# ---- Runtime (web and worker) ----
NODE_ENV=development
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
MEDIA_ORIGIN=http://localhost:9000/ad-media
SENTRY_DSN=

# ---- Web only ----
COOKIE_PREFIX_SECURE=false
TRUSTED_PROXY_MODE=none
PWA_ENABLED=true
APP_VERSION=dev
EDGE_TOKEN_MODE=off
DEV_SKIP_MFA=false
MAX_UPLOAD_BYTES=5368709120
UPLOAD_PART_BYTES=8388608
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=no-reply@localhost
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Databases ----
DATABASE_URL=
DATABASE_URL_WORKER=
DATABASE_URL_MIGRATE=
KEYS_DATABASE_URL_MIGRATE=
KEYS_DATABASE_URL=
KEYS_DATABASE_URL_SHRED=

# ---- Secrets (32 byte base64) ----
FIELD_KEK=
FIELD_KEK_PREVIOUS=
EMAIL_HASH_PEPPER=
HLS_KEK=
HLS_KEK_PREVIOUS=
PLAYBACK_TOKEN_SECRET=
PLAYBACK_TOKEN_SECRET_PREVIOUS=
MEDIA_URL_SECRET=

# ---- Storage ----
STORAGE_DRIVER=s3
LOCAL_STORAGE_ROOT=./.local-storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BUCKET_ORIGINALS=ad-originals
BUCKET_MEDIA=ad-media

# ---- Worker ----
MAX_VIDEO_SECONDS=1800
WHISPER_URL=http://localhost:8000
FFMPEG_PRESET=veryfast
FFMPEG_THREADS=0
WORKER_SCRATCH_DIR=/tmp/ad-work

# ---- Deploy and container only (not read by the app loaders) ----
APP_DOMAIN=
MEDIA_DOMAIN=
WHISPER_MODEL=small.en
WHISPER_COMPUTE_TYPE=int8
POSTGRES_PASSWORD=
DB_ROLE_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_IMAGE=
MC_IMAGE=
