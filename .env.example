# Names only. Copy to .env and fill dev values. Never commit .env.
# Generate each 32 byte key with: openssl rand -base64 32

# ---- Runtime (web and worker) ----
NODE_ENV=development
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
MEDIA_ORIGIN=http://localhost:9000/ad-media
SENTRY_DSN=

# ---- Web only ----
COOKIE_PREFIX_SECURE=false
TRUSTED_PROXY_MODE=none
PWA_ENABLED=true
APP_VERSION=dev
EDGE_TOKEN_MODE=off
DEV_SKIP_MFA=false
# Emergency switch for viewer two step verification. Leave on.
VIEWER_MFA_ENABLED=true
CSP_REPORT_ONLY=false
SUPPORT_EMAIL=
MAX_UPLOAD_BYTES=5368709120
UPLOAD_PART_BYTES=8388608
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=no-reply@localhost
# Signs bounce and complaint callbacks at /api/webhooks/email (HMAC SHA256 in x-webhook-signature). Empty keeps the endpoint closed.
EMAIL_WEBHOOK_SECRET=
# Cloudflare Turnstile on sign in and sign up. Both keys together turn it on; leave both empty to turn it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional Google sign in. Set both or neither. Redirect URI: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Donations (M48). Leave empty until the owner has a Paystack account. A test key works anywhere, a live key only in production.
PAYSTACK_SECRET_KEY=
# Only change this for a local fake Paystack server in tests.
PAYSTACK_BASE_URL=https://api.paystack.co
# 32 random bytes as base64. Optional: derived from an existing secret when empty.
DONATE_RECEIPT_TOKEN_SECRET=

# ---- Databases ----
DATABASE_URL=
DATABASE_URL_WORKER=
DATABASE_URL_MAINTENANCE=
DATABASE_URL_MIGRATE=
KEYS_DATABASE_URL_MIGRATE=
KEYS_DATABASE_URL=
KEYS_DATABASE_URL_SHRED=

# ---- Secrets (32 byte base64) ----
FIELD_KEK=
FIELD_KEK_PREVIOUS=
EMAIL_HASH_PEPPER=
HLS_KEK=
HLS_KEK_PREVIOUS=
PLAYBACK_TOKEN_SECRET=
PLAYBACK_TOKEN_SECRET_PREVIOUS=
MEDIA_URL_SECRET=

# ---- Storage ----
STORAGE_DRIVER=s3
LOCAL_STORAGE_ROOT=./.local-storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BUCKET_ORIGINALS=ad-originals
BUCKET_MEDIA=ad-media

# ---- Worker ----
MAX_VIDEO_SECONDS=1800
WHISPER_URL=http://localhost:8000
WHISPER_FAKE=
FFMPEG_PRESET=veryfast
FFMPEG_THREADS=0
WORKER_SCRATCH_DIR=/tmp/ad-work
WORKER_SCRATCH_MIN_FREE_RATIO=

# ---- Deploy and container only (not read by the app loaders) ----
APP_DOMAIN=
MEDIA_DOMAIN=
WHISPER_MODEL=small.en
WHISPER_COMPUTE_TYPE=int8
POSTGRES_PASSWORD=
DB_ROLE_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_IMAGE=
MC_IMAGE=
