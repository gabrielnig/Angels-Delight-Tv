# Production environment template. Copy to .env.production and fill it in. Never commit .env.production.
# Every variable has a tag line above it saying who provides the value:
#   [client]    comes from the client config (client.json) and is written by pnpm launch:apply
#   [applied]   written by pnpm launch:apply or deploy.sh, leave empty here
#   [owner]     the owner (ARKDEV) sets it from an account or provider
#   [generated] pnpm secrets:generate fills it in, leave empty here
#   [default]   a safe production default, change only with a reason
# Built by compose.prod.yaml and so deliberately not set here: DATABASE_URL, DATABASE_URL_WORKER,
# DATABASE_URL_MAINTENANCE, DATABASE_URL_MIGRATE, KEYS_DATABASE_URL, KEYS_DATABASE_URL_MIGRATE,
# KEYS_DATABASE_URL_SHRED, LOCAL_STORAGE_ROOT, WORKER_SCRATCH_DIR, WHISPER_FAKE.

# ---- Runtime ----
# [default]
NODE_ENV=production
LOG_LEVEL=info
# [owner]
SENTRY_DSN=
# [applied]
APP_VERSION=

# ---- Domain and brand ----
# [applied]
APP_DOMAIN=
MEDIA_DOMAIN=
APP_ORIGIN=
MEDIA_ORIGIN=
EMAIL_FROM=
# [client]
SUPPORT_EMAIL=

# ---- Web ----
# [default]
COOKIE_PREFIX_SECURE=true
TRUSTED_PROXY_MODE=cloudflare
EDGE_TOKEN_MODE=worker
PWA_ENABLED=true
CSP_REPORT_ONLY=false
DEV_SKIP_MFA=false
VIEWER_MFA_ENABLED=true
MAX_UPLOAD_BYTES=5368709120
UPLOAD_PART_BYTES=8388608
# [owner]
PWA_ICONS_DIR=
BRAND_DIR=
CLIENT_DIR=
CONTENT_DIR=
ORIGIN_CERT_DIR=
MAINTENANCE_DIR=

# ---- Email ----
# An smtp:// or smtps:// url. For a first deploy without email credentials use the word disabled: the site boots,
# verification and reset emails fail, the admin dashboard warns, and pnpm dns:check refuses to pass. Empty is refused.
# [owner]
SMTP_URL=
EMAIL_WEBHOOK_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Secrets ----
# [generated]
FIELD_KEK=
EMAIL_HASH_PEPPER=
HLS_KEK=
PLAYBACK_TOKEN_SECRET=
MEDIA_URL_SECRET=
# [owner]
FIELD_KEK_PREVIOUS=
HLS_KEK_PREVIOUS=
PLAYBACK_TOKEN_SECRET_PREVIOUS=

# ---- Storage (Cloudflare R2) ----
# [default]
STORAGE_DRIVER=s3
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
BUCKET_ORIGINALS=ad-originals
BUCKET_MEDIA=ad-media
# [owner]
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Worker ----
# [default]
MAX_VIDEO_SECONDS=1800
WHISPER_URL=http://whisper:8000
WHISPER_MODEL=small.en
# [default] Optional second model for non English audio and language detection (for example medium). Empty means English only.
WHISPER_MODEL_MULTI=
WHISPER_COMPUTE_TYPE=int8
FFMPEG_PRESET=medium
FFMPEG_THREADS=0
WORKER_SCRATCH_MIN_FREE_RATIO=0.15
WORKER_CPUS=3
WHISPER_MEM_LIMIT=4g
PG_SHARED_BUFFERS=512MB
IMAGE_PREFIX=ghcr.io/gabrielnig/angels-delight-tv

# ---- Databases ----
# [generated]
POSTGRES_PASSWORD=
DB_PASSWORD_MIGRATOR=
DB_PASSWORD_APP=
DB_PASSWORD_WORKER=
DB_PASSWORD_KEYS_APP=
DB_PASSWORD_KEYS_SHRED=
DB_PASSWORD_MAINTENANCE=

# ---- Backups ----
# [generated]
BACKUP_PUBLIC_KEY_DB_B64=
BACKUP_PUBLIC_KEY_KEYS_B64=
# [owner]
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_PING_URL=
# [default]
BACKUP_DIR=/opt/angelsdelight/backups
BACKUP_BUCKET=ad-backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_RETAIN_LOCAL_DAYS=7

# [default] Caption translation (M46). Off by default. google needs TRANSLATE_API_KEY and a non zero monthly cap. DEV_PSEUDO_LOCALE is a development flag and must stay false.
DEV_PSEUDO_LOCALE=false
TRANSLATE_PROVIDER=none
TRANSLATE_API_KEY=
TRANSLATE_MAX_CHARS_PER_JOB=60000
TRANSLATE_MONTHLY_CHAR_CAP=0

# ---- Donations (Paystack, M48) ----
# Optional until donations are switched on. Donations stay off while either secret is empty. sk_test_ keys are for staging, sk_live_ only in production.
# DONATE_RECEIPT_TOKEN_SECRET is 32 random bytes in base64 (openssl rand -base64 32) and signs donation receipt links.
# [owner]
PAYSTACK_SECRET_KEY=
DONATE_RECEIPT_TOKEN_SECRET=
# [default]
PAYSTACK_BASE_URL=https://api.paystack.co

# ---- Sign in with Google ----
# Optional. Set both or neither. Create an OAuth client in Google Cloud and add the site callback URL.
# [owner]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
